# Soul Economy backend env vars. Copy to .env of your local tools or the
# Render "Environment Variables" tab (the Render dashboard is the live source).

# Supabase project (dashboard.supabase.com → New project).
# Anon key is safe for the browser; service key is CI/servers ONLY,
# never ship it, never put it in frontend code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Stripe (dashboard.stripe.com/apikeys + /webhooks for the secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Helius webhook secret (optional; plain memo `soul:<order-uuid>` matched if absent).
HELIUS_WEBHOOK_SECRET=

# Absolute base for product images (GitHub Pages, egress-free).
ASSET_BASE=https://uncommonpope-png.github.io/soul-economy/
APP_VERSION=2.0.0