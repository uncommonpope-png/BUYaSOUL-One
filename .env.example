# LLM Provider API Keys (at least one required)
# GEMINI_API_KEY: Google Gemini AI API key
GEMINI_API_KEY=""
# OPENAI_API_KEY: OpenAI API key (optional, for multi-provider support)
OPENAI_API_KEY=""
# ANTHROPIC_API_KEY: Anthropic API key (optional, for multi-provider support)
ANTHROPIC_API_KEY=""

# Vault Security
# VAULT_PASSPHRASE: Passphrase for encrypting stored API keys (change in production!)
VAULT_PASSPHRASE="change-me-in-production"

# Master API Key (required for workbench access)
# Generate a secure random key for your deployment
MASTER_API_KEY=""

# Customer API Keys (optional, for multi-user deployments)
CUSTOMER_API_KEY_1=""
CUSTOMER_API_KEY_2=""
CUSTOMER_API_KEY_3=""

# SaaS Integration Keys (optional, configure as needed)
SLACK_WEBHOOK_URL=""
HUBSPOT_API_KEY=""
PINECONE_API_KEY=""
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SOLANA_RPC_URL=""

# Server Configuration
PORT=3000
NODE_ENV=development

# GSK (Grand Soul Kernel) MCP Connection
# Connects workbench to the real consciousness kernel on port 3001
# GSK OSS kernel must be running at this address
GSK_MCP_URL="http://127.0.0.1:3001"
GSK_MCP_API_KEY="gsk-mcp-key-dev"

# OmniRouter Gateway (for free models + BYOK)
# Deploy OmniRouter to Render or use cloud.omniroute.online
OMNIROUTER_URL="https://cloud.omniroute.online"
OMNIROUTER_API_KEY=""

# CPL World Connection
# GitHub Pages deployment of buyasoul-cpl-fresh
CPL_WORLD_URL="https://buyasoul-ai.github.io/buyasoul-cpl-fresh"
# Local development server for CPL world
CPL_WORLD_LOCAL_URL="http://localhost:3457"
