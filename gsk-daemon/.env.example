# GSK Build Targets — copy to .env and fill in your keys
# Point autonomous loops + direct-build at real projects, not GSK's own folder
GSK_PROJECT_ROOTS=C:\Users\uncom\Desktop\buyasoul-cpl-fresh;C:\Users\uncom\Desktop\allie\buyasoul-core\gsk
GSK_AUTONOMY_ENABLED=true
GSK_AUTONOMY_INTERVAL_MS=1800000
GSK_AUTONOMY_FIRST_DELAY_MS=90000

# NineRouter for OmniRoute A2A — REQUIRED (get from OmniRoute dashboard)
NINE_ROUTER_API_KEY=

# Model (free tier by default)
GSK_MODEL=free

# MCP/API keys (removed hardcoded defaults per OSS plan)
# Set these in environment or .env.local (not committed)
MCP_API_KEY=
OMNIROUTE_API_KEY=

# Optional: Brain/Heart specific keys (fall back to NINE_ROUTER_API_KEY)
# GSK_BRAIN_API_KEY=
# GSK_HEART_API_KEY=

# Optional: Custom router URLs
# GSK_BRAIN_ROUTER_URL=http://127.0.0.1:20128
# GSK_HEART_ROUTER_URL=http://127.0.0.1:20128
# NINE_ROUTER_URL=http://127.0.0.1:20128